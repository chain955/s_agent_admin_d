# Copy to .env.development for local development.
# All public env vars must be prefixed with VITE_.

# Backend the Vite dev proxy forwards API calls to.
VITE_BACKEND_URL=http://localhost:8000

# Optional: same-origin assumed in prod, leave empty there.
# Only set this if the SPA must call a different origin (it shouldn't on MVP).
VITE_API_BASE_URL=
