{
  "name": "sport-agent-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "predev": "pnpm gen",
    "dev": "vite",
    "prebuild": "pnpm gen",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretypecheck": "pnpm gen",
    "typecheck": "tsc -b --noEmit",
    "pretest": "pnpm gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "pnpm gen:api && pnpm gen:routes",
    "gen:api": "openapi-typescript ./openapi.json -o src/api/schema.gen.ts",
    "gen:api:remote": "node scripts/fetch-openapi.mjs && pnpm gen:api",
    "gen:routes": "tsr generate",
    "accept-stage": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.166.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "0.460.0",
    "next-themes": "0.4.3",
    "openapi-fetch": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "recharts": "2.13.3",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.20",
    "@tanstack/router-cli": "^1.166.0",
    "@tanstack/router-devtools": "^1.166.0",
    "@tanstack/router-plugin": "^1.167.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@eslint/js": "9.14.0",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "lefthook": "1.8.4",
    "msw": "2.6.5",
    "openapi-typescript": "7.4.3",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.4"
  }
}
